{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/integration/.*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^test/(.*)$": "<rootDir>/test/$1"
  },
  "testEnvironment": "node",
  "maxWorkers": 1,
  "detectOpenHandles": true,
  "forceExit": false,
  "setupFiles": ["<rootDir>/test/integration/setup/test-env.ts"]
}